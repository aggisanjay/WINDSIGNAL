# =========================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway / Server)
# =========================================================================
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# In Production: set to your Vercel URL e.g. https://windsignal.vercel.app or *
CORS_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000
CACHE_DIR=backend/data_cache

# =========================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# =========================================================================
# In Production: point to your deployed backend URL on Render or Railway
# e.g. https://windsignal-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
